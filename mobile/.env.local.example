# Deployed workout web app the iPhone app loads (must be reachable from the phone, not localhost).
EXPO_PUBLIC_WEB_URL=
# CLIENT_ID from the Firebase iOS app's GoogleService-Info.plist for bundle id
# com.astrojason.workout (same Firebase project as web/). Used for native Google sign-in.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional: Apple Developer Team ID, so the Watch target is signed automatically.
APPLE_TEAM_ID=
